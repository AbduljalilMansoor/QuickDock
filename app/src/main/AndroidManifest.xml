<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- الدرج واللسان يظهران فوق كل التطبيقات (يُمنح من صفحة التثبيت عبر ADB) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- لعرض كل التطبيقات المثبتة في «All apps» -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- مبدّل التطبيقات: قراءة التطبيقات المستخدمة مؤخراً، وإغلاق عمليات الخلفية -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <!-- ودجت الطقس/الصلاة: موقع السيارة -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- قراءة بيانات السيارة (مسار احتياطي عبر CarPropertyManager) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED"/>
    <uses-permission android:name="android.car.permission.CAR_ENERGY"/>
    <uses-permission android:name="android.car.permission.CAR_MILEAGE"/>
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN"/>
    <uses-permission android:name="android.car.permission.CAR_INFO"/>

    <application
        android:label="QuickDock"
        android:icon="@android:drawable/ic_menu_more"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">

        <uses-library android:name="android.car" android:required="false"/>
        <uses-library android:name="autolink.sdk" android:required="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- مصمّم شاشة العدادات -->
        <activity
            android:name=".DeckActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout"/>

        <!-- الشاشة التي تُعرض على Display 2 (العدادات) -->
        <activity
            android:name=".DeckDisplayActivity"
            android:exported="true"
            android:taskAffinity="com.quickdock.app.deck"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout"/>

        <service android:name=".DockService" android:exported="false"/>
        <service android:name=".BeltService" android:exported="false"/>

        <!-- يسمح لودجت الوسائط بقراءة جلسات التشغيل والتحكم بها (يُمنح من صفحة التثبيت) -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="QuickDock"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver android:name=".InstallReceiver" android:exported="false"/>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
